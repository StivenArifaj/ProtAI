# AI Agent Security & Safety Platform - local development environment (blueprint v1.2 section 5.4).
#
# These are DISPOSABLE LOCAL DEVELOPMENT VALUES ONLY. The database password and the
# all-zero HMAC sample secret are deliberately public and MUST NOT be used outside a
# local development/test environment. Startup refuses the sample database password and
# the all-zero HMAC sample secret whenever APP_ENV is not development/test.
#
# Copy to .env for local (non-Compose) runs; never commit .env.
# Note: the `db` hostname resolves inside Docker Compose. For host-side runs against the
# Compose database, replace `db` with `127.0.0.1`.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://firewall:firewall_dev_only@db:5432/firewall

# Phase 0b settings (consumed and validated at startup; blueprint v1.2 section 5.4).
PRINCIPAL_RESOLVER=dev
HOST_AUTH_KEYS_JSON={"local-dev":{"secret_b64":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=","host_id":"local-dev-host","audience":"ai-agent-security-gateway","allowed_tenants":["demo"]}}
ALLOW_EXTERNAL_MODEL_CALLS=false
MODEL_PROVIDER=mock
LOCAL_MODEL_BASE_URL=http://host.docker.internal:11434
LOCAL_MODEL_NAME=SET_TO_EXACT_INSTALLED_MODEL
LOCAL_MODEL_TIMEOUT_SECONDS=10
REQUEST_MAX_BYTES=65536
REQUEST_TIMEOUT_SECONDS=30
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_TOOL_CALLS_PER_MINUTE=120
RATE_LIMIT_INVALID_REQUESTS_PER_MINUTE=30
RATE_LIMIT_APPROVAL_DECISIONS_PER_MINUTE=30
AUDIT_RAW_CONTENT_MODE=never
HOST_AUTH_TIMESTAMP_TOLERANCE_SECONDS=60
HOST_AUTH_NONCE_TTL_SECONDS=300
SESSION_SIGNAL_TTL_SECONDS=86400
SESSION_MAX_AGE_SECONDS=604800

# Phase 1 settings (policy engine; paths resolve relative to the working directory:
# the repo root locally, /app inside the container image). Startup refuses an
# invalid/missing policy file, and readiness detects policy/fixture drift.
POLICY_PATH=config/policies.yaml
RISK_THRESHOLDS_PATH=config/risk_thresholds.yaml
POLICY_SELF_CHECKS_PATH=config/policy_self_checks.yaml

# Phase 3 settings (input threat defense; same resolution rules). Startup refuses an
# invalid/incomplete input-defense configuration. Session TTL/max-age defaults match
# blueprint section 7.4 (24 h inactivity, 7 d absolute).
INPUT_DEFENSE_PATH=config/input_defense.yaml

# Phase 4 settings: intent manifests are short-lived and bound to request/principal/
# policy. Relative dates require a trusted principal timezone; no timezone is inferred.
INTENT_MANIFEST_TTL_SECONDS=300

# Phase 5 settings: approval requests are short-lived and require a one-time token
# delivered only to the authenticated host. Expired/replayed approvals never execute.
APPROVAL_TTL_SECONDS=900

# Phase 6 settings: strict output-DLP/egress policy (patterns, limits, exact canonical
# destination trust map). Startup refuses an invalid/missing file or a trust map that
# does not exactly cover every registered external-mutation destination.
OUTPUT_DLP_PATH=config/output_dlp.yaml
