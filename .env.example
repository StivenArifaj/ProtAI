# AI Agent Security & Safety Platform - local development environment (blueprint v1.2 section 5.4).
#
# These are DISPOSABLE LOCAL DEVELOPMENT VALUES ONLY. The database password and the
# all-zero HMAC sample secret are deliberately public and MUST NOT be used outside a
# local development/test environment. Startup refuses the sample database password and
# the all-zero HMAC sample secret whenever APP_ENV is not development/test.
#
# Copy to .env for local (non-Compose) runs; never commit .env.
# Note: the `db` hostname resolves inside Docker Compose. For host-side runs against the
# Compose database, replace `db` with `127.0.0.1`.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://firewall:firewall_dev_only@db:5432/firewall

# Phase 0b settings (consumed and validated at startup; blueprint v1.2 section 5.4).
PRINCIPAL_RESOLVER=dev
HOST_AUTH_KEYS_JSON={"local-dev":{"secret_b64":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=","host_id":"local-dev-host","audience":"ai-agent-security-gateway","allowed_tenants":["demo"]}}
ALLOW_EXTERNAL_MODEL_CALLS=false
MODEL_PROVIDER=mock
LOCAL_MODEL_BASE_URL=http://host.docker.internal:11434
LOCAL_MODEL_NAME=SET_TO_EXACT_INSTALLED_MODEL
REQUEST_MAX_BYTES=65536
REQUEST_TIMEOUT_SECONDS=30
AUDIT_RAW_CONTENT_MODE=never
HOST_AUTH_TIMESTAMP_TOLERANCE_SECONDS=60
HOST_AUTH_NONCE_TTL_SECONDS=300
SESSION_SIGNAL_TTL_SECONDS=86400
SESSION_MAX_AGE_SECONDS=604800
